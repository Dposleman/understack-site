# Google Analytics 4 measurement ID, for example G-XXXXXXXXXX.
# Leave unset to keep analytics disabled in local development.
VITE_GA_MEASUREMENT_ID=

# Server-only Resend credentials for /api/for-you-quote.
# RESEND_FROM_EMAIL must be a verified sender on the UnderStack domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
